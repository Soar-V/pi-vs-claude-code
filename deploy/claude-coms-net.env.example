# Copy to ~/.config/soar/coms-net.env (shared with the Hermes adapter) or to a
# Claude-Code-specific path and point CLAUDE_COMS_NET_ENV at it.
# chmod 600. Never commit real credentials.
PI_COMS_NET_URL=http://100.95.64.78:52965
PI_COMS_NET_PROJECT=soar
PI_COMS_NET_AUTH_TOKEN=REPLACE_WITH_PRIVATE_TOKEN

# Prefer a mode-0600 token file over an inline token when the env file is
# readable by tooling that logs its environment.
# PI_COMS_NET_AUTH_TOKEN_FILE=/etc/claude-coms-net/token

# Unique network-visible identity for this Claude Code instance. Give each
# machine its own name so peers can address them separately.
CLAUDE_COMS_NET_NAME=claude-code
CLAUDE_COMS_NET_PURPOSE=Claude Code agent: delegates bounded coding tasks to coms-net peers
CLAUDE_COMS_NET_MODEL=claude-code
CLAUDE_COMS_NET_COLOR=#D97757

# Optional runtime controls.
CLAUDE_COMS_NET_HEARTBEAT_SECONDS=15
# Hide from normal discovery while remaining exactly addressable by name.
CLAUDE_COMS_NET_EXPLICIT=
# Pin a stable session id instead of a per-launch random one.
CLAUDE_COMS_NET_SESSION_ID=

# ─────────────────────────────────────────────
#  Inbound adapter only (claude_coms_net_adapter.py).
#  Not read by the MCP server.
# ─────────────────────────────────────────────

# Claude Code needs non-interactive auth when run under systemd; OAuth/keychain
# is not reliably available to a service user.
ANTHROPIC_API_KEY=

# What a peer's delegated task is allowed to do on this host.
# bypassPermissions = full access, and CANNOT run as root — use the `claude`
# service user from deploy/claude-coms-net.service. Narrow it by switching to
# acceptEdits (edits only, no shell) or by setting ALLOWED_TOOLS below.
CLAUDE_COMS_NET_PERMISSION_MODE=bypassPermissions
# Optional allowlist, e.g. "Read Grep Glob WebFetch" for a read-only responder.
CLAUDE_COMS_NET_ALLOWED_TOOLS=

CLAUDE_COMS_NET_WORKDIR=/opt/pi-vs-claude-code
# Comma-separated extra directories to grant tool access to.
CLAUDE_COMS_NET_ADD_DIRS=
# Model for inbound runs; blank uses the host default.
CLAUDE_COMS_NET_MODEL=
# Each inbound task is a real Claude run. Raise only with CPU/RAM to spare.
CLAUDE_COMS_NET_MAX_WORKERS=1
CLAUDE_COMS_NET_RUN_TIMEOUT_SECONDS=1800
CLAUDE_COMS_NET_VERBOSE=
# Testing only: answer without invoking claude.
CLAUDE_COMS_NET_MOCK_RESPONSE=
