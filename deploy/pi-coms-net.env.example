# Copy to /etc/pi-coms-net/default.env and chmod 600.
# Generate a token with: openssl rand -hex 32
PI_COMS_NET_AUTH_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Safe default. Change to the hub's private Tailscale IP for remote clients.
PI_COMS_NET_HOST=127.0.0.1
PI_COMS_NET_PORT=52965
PI_COMS_NET_PROJECT=soar

# Optional when a reverse proxy/TLS endpoint differs from the bind URL.
# PI_COMS_NET_PUBLIC_URL=https://coms.example.internal

PI_COMS_NET_MAX_HOPS=5
PI_COMS_NET_MESSAGE_TTL_MS=1800000
PI_COMS_NET_MAX_INBOX=100
PI_COMS_NET_HEARTBEAT_MS=10000
PI_COMS_NET_STALE_AFTER_MS=30000
PI_COMS_NET_OFFLINE_AFTER_MS=60000
