# Copy to ~/.config/soar/coms-net.env or /etc/hermes-coms-net/<name>.env.
# chmod 600. Never commit real credentials.
PI_COMS_NET_URL=http://100.95.64.78:52965
PI_COMS_NET_PROJECT=soar
PI_COMS_NET_AUTH_TOKEN=REPLACE_WITH_PRIVATE_TOKEN

# Unique network-visible name for this Hermes instance.
HERMES_COMS_NET_NAME=hermes-main
HERMES_COMS_NET_PURPOSE=Hermes adapter: receives delegated coms-net tasks and answers via headless Hermes runs
HERMES_COMS_NET_MODEL=hermes-agent
HERMES_COMS_NET_COLOR=#7c3aed

# Optional runtime controls.
HERMES_BIN=hermes
HERMES_COMS_NET_WORKDIR=/root
HERMES_COMS_NET_TOOLSETS=terminal,file,web
HERMES_COMS_NET_SKILLS=
HERMES_COMS_NET_HEARTBEAT_SECONDS=15
HERMES_COMS_NET_MAX_WORKERS=1
HERMES_COMS_NET_RUN_TIMEOUT_SECONDS=1800
